# =============================================================================
# MoneyPrinterTurbo Environment Configuration Template
# Copy this file to .env and fill in your respective API keys.
# DO NOT commit your real .env file with secrets to version control.
# =============================================================================

# --- LLM Provider Settings ---
# Options: opencode, openai, gemini, qwen, deepseek, ollama, azure, moonshot, cloudflare, groq, oneapi
LLM_PROVIDER=opencode

# OpenCode AI Configuration
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL_NAME=muse-spark-1.3-contributor-free

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# DeepSeek Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-70b-versatile

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1

# --- Video & Image Material Provider Settings ---
# Options: pexels, pixabay, cf_worker
VIDEO_SOURCE=cf_worker

# Cloudflare Worker AI Image Generation
CF_WORKER_IMAGE_URL=https://your-worker-name.your-subdomain.workers.dev
CF_WORKER_IMAGE_KEY=

# Pexels Video/Image API
PEXELS_API_KEY=

# Pixabay API
PIXABAY_API_KEY=

# --- Text-to-Speech (TTS) Configuration ---
# Options: edge, azure, openai
TTS_PROVIDER=edge
TTS_VOICE=en-US-ChristopherNeural

# --- Server & UI Configuration ---
HOST=127.0.0.1
PORT=8080

# =============================================================================
# Publishing (Upload-Post) - drives the automatic cross-post to
# TikTok / Instagram / YouTube Shorts.
#
# A video is published only when UPLOAD_POST_ENABLED and UPLOAD_POST_AUTO_UPLOAD
# are BOTH true AND the credentials below are set. These are parsed as real
# booleans, so a typo is ignored rather than silently treated as "true".
# Keep AUTO_UPLOAD=false to generate without publishing.
# =============================================================================
UPLOAD_POST_ENABLED=false
UPLOAD_POST_AUTO_UPLOAD=false
UPLOAD_POST_API_KEY=
UPLOAD_POST_USERNAME=
UPLOAD_POST_PLATFORMS=youtube,tiktok,instagram
UPLOAD_POST_YOUTUBE_PRIVACY_STATUS=public
UPLOAD_POST_YOUTUBE_MADE_FOR_KIDS=false

# =============================================================================
# AutoShorts automation runner (python -m automation.runner)
# Command-line flags override every value below.
# =============================================================================
# Source type: rss | topics_file
AUTOSHORTS_SOURCE_TYPE=topics_file
# For topics_file: path to your backlog. For rss: leave blank and set the URL.
AUTOSHORTS_SOURCE_PATH=automation/topics.txt
AUTOSHORTS_SOURCE_URL=
# Override the source name used in dedupe keys (defaults to the source type).
AUTOSHORTS_SOURCE_NAME=
# How many videos to generate per run. Start at 1.
AUTOSHORTS_LIMIT=1
# How many topics to pull from the source before filtering out known ones.
AUTOSHORTS_FETCH_LIMIT=50
# Pipeline stage to stop at: script|terms|audio|subtitle|materials|video
AUTOSHORTS_STOP_AT=video
# Plan only: no generation, no publishing, no ledger writes.
AUTOSHORTS_DRY_RUN=true
# Optional JSON file of VideoParams defaults applied to every task.
AUTOSHORTS_PARAMS_TEMPLATE=
# Optional ledger database path (defaults to storage/automation/ledger.db).
AUTOSHORTS_LEDGER=

# ── Agent tooling (chatbot: web search) ────────────────────────────────────
# TinyFish Search API — free, `GET https://api.search.tinyfish.ai`, X-API-Key header.
# Get a key at https://agent.tinyfish.ai/api-keys
TINYFISH_API_KEY=

# ── Operations catalog (assistant tool risk gate) ──
# Whether the in-app assistant may run operations that COST MONEY or are
# PUBLIC/IRREVERSIBLE (generating media, running a batch, publishing).
# 0 = refused (default). Set to 1 only when you want the assistant to act.
AGENT_ALLOW_SPEND=0
# Interpreters for the CLI wrappers. The pipeline and the assembly engine have
# separate virtualenvs, so these cannot be inferred.
# PIPELINE_PYTHON=
# ASSEMBLY_PYTHON=
# PIPELINE_ROOT=
