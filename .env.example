# =============================================================================
# MoneyPrinterTurbo Environment Configuration Template
# Copy this file to .env and fill in your respective API keys.
# DO NOT commit your real .env file with secrets to version control.
# =============================================================================

# --- LLM Provider Settings ---
# Options: opencode, openai, gemini, qwen, deepseek, ollama, azure, moonshot, cloudflare, groq, oneapi
LLM_PROVIDER=opencode

# OpenCode AI Configuration
OPENCODE_API_KEY=
OPENCODE_BASE_URL=https://opencode.ai/zen/v1
OPENCODE_MODEL_NAME=muse-spark-1.3-contributor-free

# OpenAI Configuration
OPENAI_API_KEY=
OPENAI_BASE_URL=https://api.openai.com/v1
OPENAI_MODEL_NAME=gpt-4o-mini

# Google Gemini Configuration
GEMINI_API_KEY=
GEMINI_MODEL_NAME=gemini-1.5-flash

# DeepSeek Configuration
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL_NAME=deepseek-chat

# Groq Configuration
GROQ_API_KEY=
GROQ_MODEL_NAME=llama-3.1-70b-versatile

# Ollama Configuration
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL_NAME=llama3.1

# --- Video & Image Material Provider Settings ---
# Options: pexels, pixabay, cf_worker
VIDEO_SOURCE=cf_worker

# Cloudflare Worker AI Image Generation
CF_WORKER_IMAGE_URL=https://your-worker-name.your-subdomain.workers.dev
CF_WORKER_IMAGE_KEY=

# Pexels Video/Image API
PEXELS_API_KEY=

# Pixabay API
PIXABAY_API_KEY=

# --- Text-to-Speech (TTS) Configuration ---
# Options: edge, azure, openai
TTS_PROVIDER=edge
TTS_VOICE=en-US-ChristopherNeural

# --- Server & UI Configuration ---
HOST=127.0.0.1
PORT=8080
